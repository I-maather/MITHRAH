# ---------------------------------------------------------------------------
# Maather Trader — mobile client environment (PLACEHOLDERS ONLY)
# ---------------------------------------------------------------------------
#
# انسخي هذا الملف إلى `.env` واملئيه على جهاز المالكة فقط.
# Copy to `.env` locally. `.env` is git-ignored and must never be committed.
#
# ما لا يوجد هنا، ولا يجوز أن يوجد هنا أبداً:
# NOT HERE, EVER — these belong to the FastAPI backend and nowhere else:
#   * broker API key / identifier / password
#   * broker session tokens of any kind
#   * market-data, news and macro provider keys
#   * the Apple push signing key, its key id, or the team id
#   * database URL, order-signing secret
#
# The mobile app is a read-only monitoring client with three risk-REDUCING
# actions. It cannot place, size, modify or close anything, so it needs no
# credential capable of doing so.
# ---------------------------------------------------------------------------

# Backend base URL. MUST be a private / loopback address, or an https:// host
# reachable only from the owner's own network. The client refuses plain http://
# to anything that is not a loopback or RFC1918 address.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# iOS bundle identifier. Provisional — nothing is registered with Apple yet.
EXPO_PUBLIC_IOS_BUNDLE_ID=com.maather.autonomoustrader

# Minutes of inactivity before the app locks itself and requires Face ID again.
EXPO_PUBLIC_AUTO_LOCK_MINUTES=2

# Set to 1 to render the labelled preview fixtures instead of live data.
# Every screen then shows a persistent «معاينة / Preview» banner.
EXPO_PUBLIC_PREVIEW_DATA=0
