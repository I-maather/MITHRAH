# قالب بيئة الخلفية — قيم نائبة فقط، لا أسرار.
#
# الربط الافتراضي **حلقي**. الخروج عنه قرار صريح موثَّق، لا سهو في ملف إعداد.
MAATHER_HOST=127.0.0.1
MAATHER_PORT=8000

# التداول الحقيقي يبقى مقفلاً. تغييره لا يكفي وحده — الأقفال الأربعة مستقلة.
LIVE_TRADING=false

# مفاتيح المزوّدين **لا تُكتب هنا**. مكانها Keychain عبر:
#   ./scripts/configure_provider_credentials.sh
# FMP_API_KEY=<in-keychain>
# FINNHUB_API_KEY=<in-keychain>
# FRED_API_KEY=<in-keychain>

# اعتمادات APNs — **لم تُنشَأ بعد**، وتُضبَط محلياً حين تُنشئها المالكة.
# APNS_KEY_ID=<not-created-yet>
# APPLE_TEAM_ID=<not-created-yet>
# IOS_BUNDLE_ID=com.maather.autonomoustrader
# APNS_PRIVATE_KEY_P8_PATH=<outside-the-repository>
