# ============================================================
# Maather Autonomous Trader — نموذج البيئة
# انسخيه إلى .env . هذا الملف للإعدادات غير السرّية فقط.
#
# ⛔ لا تضعي هنا مفتاح API ولا معرّف الدخول ولا كلمة مرور المفتاح.
#    الأسرار تُضبط عبر:  ./scripts/configure_capital_credentials.sh
#    وتُخزَّن في macOS Keychain أو في secrets/capital.env بصلاحية 600،
#    وكلاهما مستثنى من Git.
# ============================================================

# --- الأقفال على المال الحقيقي ------------------------------
# التداول الحقيقي مقفل أيضاً في الكود (safety.LIVE_API_ENABLED=False)،
# وهذه المتغيرات وحدها لا تكفي لفتحه.
LIVE_TRADING=false
BROKER_MODE=MOCK              # MOCK | CAPITAL_COM_DEMO | IBKR_PAPER | IBKR_LIVE
LIVE_APPROVAL_FILE=./secrets/live_approval.json

# وضع المخاطرة. أي قيمة غير VALIDATION أو LOCKED_REVIEW تتطلب
# LIVE_TRADING=true + ملف الموافقة.
RISK_MODE=VALIDATION          # VALIDATION | LIVE_COMMISSIONING | CONSERVATIVE_LIVE | LOCKED_REVIEW

# --- Capital.com (إعدادات غير سرّية فقط) --------------------
# البيئة الافتراضية والوحيدة المسموحة تحت الإصدار الحالي.
CAPITAL_ENVIRONMENT=demo

# الأسرار التالية **لا تُوضع هنا**. تُذكر للتوثيق فقط:
#   CAPITAL_API_KEY        → Keychain / secrets/capital.env
#   CAPITAL_IDENTIFIER     → Keychain / secrets/capital.env
#   CAPITAL_API_PASSWORD   → Keychain / secrets/capital.env  (كلمة مرور المفتاح، لا كلمة مرور الحساب)

# --- رأس المال المرجعي --------------------------------------
# تغييره يعيد حساب كل حدود المخاطر. اتبعي OPERATIONS_RUNBOOK §6.
BASELINE_EQUITY_USD=150.00

# --- قاعدة البيانات ----------------------------------------
DATABASE_URL=sqlite:///./data/maather.db
# للإنتاج:
# DATABASE_URL=postgresql+psycopg://maather:CHANGE_ME@127.0.0.1:5432/maather

# --- IBKR (مرحلة مستقبلية — معطّل) ---------------------------
# انظري docs/IBKR_FUTURE_PHASE.md
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT_ID=

LOG_LEVEL=INFO
