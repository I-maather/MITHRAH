# ============================================================
# Maather Autonomous Trader — نموذج البيئة
# انسخيه إلى .env . لا تضعي أسراراً حقيقية في هذا الملف.
# ============================================================

# --- الأقفال الثلاثة على المال الحقيقي ---------------------
# لا تغيّري هذين إلا بعد اجتياز docs/LIVE_ACTIVATION_CHECKLIST.md كاملة.
LIVE_TRADING=false
BROKER_MODE=MOCK              # MOCK | IBKR_PAPER | IBKR_LIVE
LIVE_APPROVAL_FILE=./secrets/live_approval.json

# وضع المخاطرة. أي قيمة غير VALIDATION تتطلب LIVE_TRADING=true + ملف الموافقة.
RISK_MODE=VALIDATION          # VALIDATION | LIVE_COMMISSIONING | CONSERVATIVE_LIVE

# --- رأس المال المرجعي --------------------------------------
# تغييره يعيد حساب كل حدود المخاطر. اتبعي OPERATIONS_RUNBOOK §6.
BASELINE_EQUITY_USD=150.00

# --- قاعدة البيانات ----------------------------------------
DATABASE_URL=sqlite:///./data/maather.db
# للإنتاج:
# DATABASE_URL=postgresql+psycopg://maather:CHANGE_ME@127.0.0.1:5432/maather

# --- IBKR (تُملأ بعد فتح الحساب — انظري docs/IBKR_SETUP.md) --
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT_ID=

LOG_LEVEL=INFO
